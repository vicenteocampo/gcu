# Copy this file to .env.local and fill in real values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
RESEND_API_KEY=

# Active email transport for now (Gmail SMTP via an App Password) — see
# lib/email/mailer.ts. Switch back to Resend once a sending domain is set up.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Admin CMS access — comma-separated allow-list of admin emails
ADMIN_EMAILS=

# Admin login is a separate email + static 6-digit PIN gate (app/admin/login),
# not the customer-facing email+OTP flow. ADMIN_SESSION_SECRET signs the
# login cookie — keep it stable (rotating it logs everyone out).
ADMIN_PIN=
ADMIN_SESSION_SECRET=

# Sign-up is invite-only: a valid referral code is required. This bootstrap
# code always validates (no real profile needs to exist yet) — hand it to
# your very first invitees, then everyone after that uses a real referral
# code. Regenerate any time by changing this value.
BOOTSTRAP_INVITE_CODE=

# Base URL used in emails / redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/lifecycle-emails from unauthenticated calls. Vercel
# Cron sends this automatically as a Bearer token when set — see vercel.json.
CRON_SECRET=
