# Copy this file to .env.local and fill in real values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
RESEND_API_KEY=

# Admin CMS access — comma-separated allow-list of admin emails
ADMIN_EMAILS=

# Base URL used in emails / redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: protects /api/cron/lifecycle-emails from unauthenticated calls
CRON_SECRET=
